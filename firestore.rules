rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 目前登入者的白名單文件（文件 id 就是 email）
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    // 登入不限網域，users 白名單就是唯一的門
    function isWhitelisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && userDoc().active == true;
    }

    function isAdmin() {
      return isWhitelisted() && userDoc().role == 'admin';
    }

    /**
     * 白名單文件的資料驗證。
     *
     * role 只收現行的三個值 —— 舊資料裡的 'editor' 仍可讀取（規則只驗寫入），
     * 但不允許再寫入，避免舊代號無限延續。
     * active 必須是布林值：字串 "true" 之類的髒資料會讓授權判斷失準。
     */
    function validUserDoc(d) {
      return d.role in ['admin', 'manager', 'specialist']
        && d.active is bool
        && d.email is string;
    }

    // 白名單本身只有 admin 能改；每個人可以讀（前端要顯示角色）。
    // delete 要與 create/update 分開 —— 刪除時沒有 request.resource，
    // 在同一條規則裡驗欄位會讓刪除永遠失敗。
    match /users/{email} {
      allow read: if isWhitelisted();
      allow create, update: if isAdmin()
        && validUserDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    // SMTP 連線設定：只放非機密欄位（主機／埠／帳號／Reply-To），
    // 密碼存在 Secret Manager。寫入一律經 updateSmtpSettings function。
    match /settings/smtp {
      allow read: if isAdmin();
      allow write: if false;
    }

    // round 28 新增：活動操作維護模式旗標（campaignOperationsPaused，見
    // shared/maintenance.ts 的完整說明）。刻意對「任何」client 端一律
    // 拒絕讀寫，即使是 admin 角色也不例外——跟上面 settings/smtp（admin
    // 可讀）不同：這份文件唯一的讀者／寫入者是 Cloud Functions 本身
    // （sendCampaign 等六個 callable 讀取；ops-maintenance.mjs CLI 透過
    // Admin SDK 寫入），不需要、也不應該讓任何前端介面直接讀寫它——維護
    // 狀態本身不是需要在後台顯示的資訊，而且開放 client 讀寫只會增加
    // 「這個安全機制被繞過或被誤用」的攻擊面。Admin SDK 本來就完全略過
    // Firestore 安全規則（Firestore 本身的設計如此），這裡的 `if false`
    // 不影響 Cloud Functions 端的讀寫，只是確保沒有任何 client 路徑能碰到
    // 這份文件。
    match /system/runtime {
      allow read: if false;
      allow write: if false;
    }

    // round 29 新增：sendSelfTestEmail 的節流冷卻紀錄（見
    // shared/selfTestEmail.ts 的完整說明）。每份文件只存
    // `{lastSentAtMs, updatedAt}`，文件 id 是 Firebase Auth 的 uid——刻意
    // 不存 email 或其他任何個資，跟 system/runtime 同一種「Functions-only，
    // 沒有任何 client 讀寫路徑」的風格：唯一的讀者／寫入者是
    // sendSelfTestEmail 這個 callable 自己的 Firestore transaction，沒有
    // 任何理由讓前端直接讀寫這份文件（就算是本人的冷卻紀錄也不用讀——前端
    // 的節流只是 UX 層的按鈕 disable，真正的節流在後端）。
    match /selfTestEmailCooldowns/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // 信件頁首與新聞聯絡人：編輯稿件時要預覽，所以全員可讀；只有 admin 能改。
    match /settings/email {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }


    // ---- settings/permissions 的結構驗證 ----
    // 規則層自己驗一次，不倚賴前端送來的內容。
    // 任何未知的角色、未知的權限鍵、非布林值都直接拒絕（fail closed）。

    function validPermissionMap(m) {
      return m is map
        && m.keys().hasOnly(['viewPress', 'editPress', 'downloadPress', 'sendTest', 'sendReal', 'manageContacts', 'manageEvents', 'viewCampaigns', 'manageUsers', 'manageSettings'])
        && (!('viewPress' in m) || m['viewPress'] is bool)
        && (!('editPress' in m) || m['editPress'] is bool)
        && (!('downloadPress' in m) || m['downloadPress'] is bool)
        && (!('sendTest' in m) || m['sendTest'] is bool)
        && (!('sendReal' in m) || m['sendReal'] is bool)
        && (!('manageContacts' in m) || m['manageContacts'] is bool)
        && (!('manageEvents' in m) || m['manageEvents'] is bool)
        && (!('viewCampaigns' in m) || m['viewCampaigns'] is bool)
        && (!('manageUsers' in m) || m['manageUsers'] is bool)
        && (!('manageSettings' in m) || m['manageSettings'] is bool);
    }

    function validRolesMap(roles) {
      return roles is map
        && roles.keys().hasOnly(['admin', 'manager', 'specialist'])
        && (!('admin' in roles) || validPermissionMap(roles['admin']))
        && (!('manager' in roles) || validPermissionMap(roles['manager']))
        && (!('specialist' in roles) || validPermissionMap(roles['specialist']));
    }

    // 管理者專屬權限不得授予其他角色，避免有人透過改權限文件提權
    function noPrivilegeEscalation(roles) {
      return true
        && (!('manager' in roles) || !('manageUsers' in roles['manager']) || roles['manager']['manageUsers'] == false)
        && (!('manager' in roles) || !('manageSettings' in roles['manager']) || roles['manager']['manageSettings'] == false)
        && (!('specialist' in roles) || !('manageUsers' in roles['specialist']) || roles['specialist']['manageUsers'] == false)
        && (!('specialist' in roles) || !('manageSettings' in roles['specialist']) || roles['specialist']['manageSettings'] == false);
    }

    match /settings/permissions {
      allow read: if isWhitelisted();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['roles', 'updatedAt'])
        && 'roles' in request.resource.data
        && validRolesMap(request.resource.data.roles)
        && noPrivilegeEscalation(request.resource.data.roles);
    }

    // ---- 動態權限矩陣的即時判斷 ----
    //
    // 這裡直接 get() settings/permissions 與 users/{email} 的即時內容，
    // 不用 custom claims —— claims 寫進 JWT 後最長要一小時才會過期刷新，
    // 管理員撤銷權限後使用者理論上還能用舊 token 繼續操作到過期為止。
    // 直接讀 Firestore 的話，規則永遠比對「當下」的資料，撤銷立即生效，
    // 不必處理任何 token 刷新的時序問題。這與既有的 isWhitelisted() /
    // isAdmin() 用同一套機制，只是延伸到完整的權限矩陣。
    //
    // 必須與 shared/permissions.ts 的 DEFAULT_PERMISSIONS 保持一致，
    // tests/firestoreRules.test.ts 會逐一比對兩邊，避免日後改一邊忘了改另一邊。

    // 舊代號沿用 shared/permissions.ts 的 normalizeRole：'editor' 視為 'specialist'。
    function normalizedRole() {
      return userDoc().role == 'editor' ? 'specialist' : userDoc().role;
    }

    function isKnownRole(role) {
      return role in ['admin', 'manager', 'specialist'];
    }

    // 對應 DEFAULT_PERMISSIONS：admin 全開；manager / specialist 各自的預設清單。
    function defaultGrant(role, permission) {
      return role == 'admin'
        || (role == 'manager' && permission in ['viewPress', 'editPress', 'downloadPress', 'sendTest', 'sendReal', 'manageContacts', 'manageEvents', 'viewCampaigns'])
        || (role == 'specialist' && permission in ['viewPress', 'editPress', 'downloadPress', 'manageContacts', 'manageEvents', 'viewCampaigns']);
    }

    // settings/permissions 不存在時視為「尚未覆寫」，一律套用預設矩陣。
    function permissionOverrides() {
      return exists(/databases/$(database)/documents/settings/permissions)
        ? get(/databases/$(database)/documents/settings/permissions).data.roles
        : null;
    }

    // 依角色與權限判斷，覆寫矩陣格式不合法時 fail closed（不猜測、不套預設）。
    function hasPermForRole(role, permission) {
      let overrides = permissionOverrides();
      let overridesOk = overrides == null || validRolesMap(overrides);
      return isKnownRole(role)
        && overridesOk
        && (
          // manageUsers / manageSettings 只有 admin 能有，覆寫矩陣對這兩項無效 ——
          // 與 shared/permissions.ts 的 ADMIN_ONLY_PERMISSIONS 邏輯一致
          permission in ['manageUsers', 'manageSettings']
            ? role == 'admin'
            : (overrides != null && role in overrides && permission in overrides[role])
              ? overrides[role][permission] == true
              : defaultGrant(role, permission)
        );
    }

    function hasPerm(permission) {
      return isWhitelisted() && hasPermForRole(normalizedRole(), permission);
    }

    /**
     * ⚠️ 這份文件的全部內容都是公開資訊 ⚠️
     *
     * 登入頁在通過驗證前就要顯示 logo，所以 read 必須對所有人開放
     * （包含未登入者、搜尋引擎、任何拿到專案 ID 的人）。
     *
     * 因此這裡**絕對不可以**存放任何機密或內部設定：
     * 不放密碼、API 金鑰、內部主機位址、員工名單、任何未公開的資訊。
     * 欄位以白名單限制，新增欄位前請先確認該內容可以公開。
     */
    function isPublicHttpsUrl(v) {
      return v is string
        && v.size() > 0
        && v.size() <= 500
        && v.matches('^https://[^\\s]+$');
    }

    match /settings/branding {
      allow read: if true;
      // 只收 logoUrl 與 updatedAt，多一個欄位就整筆拒絕
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['logoUrl', 'updatedAt'])
        && (!('logoUrl' in request.resource.data)
            || request.resource.data.logoUrl == ''
            || isPublicHttpsUrl(request.resource.data.logoUrl));
    }

    // 媒體名單：依 manageContacts 權限把關 ——
    // 管理員撤銷這項權限後，就算使用者仍在白名單裡也不能再讀寫。
    match /mediaContacts/{id} {
      allow read, write: if hasPerm('manageContacts');
    }

    // 媒體關係經營：活動與每位媒體的參加／贈送紀錄，依 manageEvents 權限把關
    match /mediaEvents/{id} {
      allow read, write: if hasPerm('manageEvents');

      match /participants/{contactId} {
        allow read, write: if hasPerm('manageEvents');
      }
    }

    // 新聞稿：讀取需要 viewPress，新增／修改／刪除需要 editPress ——
    // 兩者分開是因為權限矩陣允許某些角色只看不改。
    match /pressReleases/{id} {
      allow read: if hasPerm('viewPress');
      allow create, update, delete: if hasPerm('editPress');
    }

    // Storage 清理失敗時的重試佇列，只由 deletePressRelease（Admin SDK）寫入。
    // 開放 admin 讀取是為了讓人可以查看還有哪些檔案清理失敗、需要人工處理。
    match /storageCleanupQueue/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 發送紀錄：讀取需要 viewCampaigns，寫入一律由 Cloud Functions（Admin SDK）處理
    match /campaigns/{id} {
      allow read: if hasPerm('viewCampaigns');
      allow write: if false;

      match /recipients/{recipientId} {
        allow read: if hasPerm('viewCampaigns');
        allow write: if false;
      }

      // delivery_unknown 人工 resolution 的 immutable 稽核紀錄——只由
      // resolveDeliveryUnknown（Admin SDK）在 transaction 內用 create 寫入
      // 一次，之後永遠不再修改。client 端一律不能寫（含 admin）：這份紀錄
      // 存在的意義正是防止同一個 resolutionId 被重複套用，一旦允許 client
      // 端寫入（哪怕只是 update），就等於讓人可以繞過這個 fencing 機制本身。
      match /resolutionEvents/{resolutionId} {
        allow read: if hasPerm('viewCampaigns');
        allow write: if false;
      }
    }
  }
}
