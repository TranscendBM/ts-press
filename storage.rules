rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Storage 規則讀不到 Firestore，所以改用 custom claim。
    // 這個 claim 由 functions 的 syncUserClaims / onUserCreated 依 users 白名單寫入。
    function isPressCenterUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.pressCenter == true;
    }

    // 信件頁首 logo 等品牌素材
    match /branding/{allPaths=**} {
      allow read: if isPressCenterUser();
      allow write: if isPressCenterUser()
        && request.resource.size < 2 * 1024 * 1024;
    }

    // 新聞稿的內嵌圖與附件
    match /press/{pressId}/{allPaths=**} {
      allow read: if isPressCenterUser();
      // 單檔 10MB 上限
      allow write: if isPressCenterUser()
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
