rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---- 權限判斷：讀 custom claims，不呼叫 firestore.get() ----
    //
    // round 33 修正（緊急）：這裡原本用 firestore.get() / firestore.exists()
    // 跨服務即時讀 (default) Firestore 資料庫的 users／settings/permissions
    // 文件，理由見 git 歷史——本機模擬器實測過撤銷權限立即生效。但部署到
    // 正式環境後，兩個真實帳號（一個 specialist、一個 admin）回報上傳
    // hero 圖片與附件全部被 storage/unauthorized 擋下；逐項唯讀查證過
    // 這兩個帳號的 Firestore 白名單文件（role／active 型別與值都正確）、
    // Firebase Auth 狀態（email_verified=true、未停用）、以及正式環境
    // 實際部署的 Storage Rules 內容（與這份檔案逐字元相同），全部正常，
    // 唯獨上傳持續失敗。tests/storageRules.test.ts 的既有註解也記錄過
    // 一次「Storage 模擬器的 firestore.get() 跨服務呼叫解析到錯誤的
    // project」的真實案例，會讓所有寫入被 fail closed 成 unauthorized、
    // 表面上看起來像規則寫錯——兩者合起來強烈指向 firestore.get() /
    // firestore.exists() 這個跨服務機制在這個專案的正式執行環境裡不可靠，
    // 不是白名單或角色設定本身的問題。
    //
    // 改回這個專案本來就有、且持續在運作的機制：
    // functions/src/index.ts 的 syncUserClaims／onUserCreated／applyClaim()
    // 會把白名單的 active／role 同步成 Firebase Auth 的 custom claims
    // （`pressCenter`、`role`）——已經唯讀查證過，這兩個帳號目前的 claims
    // 內容正確、與 Firestore 白名單一致。Storage Rules 改成只讀
    // request.auth.token 裡的這兩個 claim，不再跨服務呼叫 Firestore。
    //
    // ⚠️ 已知取捨（刻意接受，不是疏漏）：
    // 1. 撤銷權限後要等使用者的 ID token 過期或重新登入才會反映到 claims，
    //    不像 firestore.get() 版本那樣立即生效——這正是當初改用
    //    firestore.get() 想解決的問題，但那個版本目前連正常上傳都做不到，
    //    兩害相權取其輕，先恢復可用性。
    // 2. settings/permissions 的角色權限覆寫矩陣只影響 Firestore 端
    //   （firestore.rules 仍然即時讀取，完全不受這次修改影響），不會
    //    反映到 Storage 端——claims 只帶 role，不帶完整的覆寫後權限矩陣。
    //    也就是說，即使管理員把 specialist 的 editPress 關掉，在 claims
    //    刷新之前，specialist 帳號原則上仍可能上傳 Storage 檔案，但無法
    //    把檔案路徑寫進 Firestore 的新聞稿文件（firestore.rules 會擋下）
    //   ——最壞結果是留下沒有被任何文件引用的孤兒檔案，不是資料外洩或
    //    越權操作。
    //
    // ⚠️ 修改這裡的權限矩陣邏輯時，firestore.rules 的對應函式也要一併
    // 檢查是否需要同步；shared/permissions.ts 的 DEFAULT_PERMISSIONS
    // 是兩邊 defaultGrant() 的共同依據。

    function isLiveWhitelisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.pressCenter == true;
    }

    // 舊代號沿用 shared/permissions.ts 的 normalizeRole：'editor' 視為 'specialist'。
    function currentRole() {
      let role = request.auth.token.role;
      return role == 'editor' ? 'specialist' : role;
    }

    function isKnownRole(role) {
      return role in ['admin', 'manager', 'specialist'];
    }

    // 對應 shared/permissions.ts 的 DEFAULT_PERMISSIONS——不讀
    // settings/permissions 覆寫矩陣，見上方【已知取捨】第 2 點。
    function defaultGrant(role, permission) {
      return role == 'admin'
        || (role == 'manager' && permission in ['viewPress', 'editPress', 'downloadPress', 'sendTest', 'sendReal', 'manageContacts', 'manageEvents', 'viewCampaigns'])
        || (role == 'specialist' && permission in ['viewPress', 'editPress', 'downloadPress', 'manageContacts', 'manageEvents', 'viewCampaigns']);
    }

    function hasPerm(permission) {
      return isLiveWhitelisted()
        && isKnownRole(currentRole())
        && defaultGrant(currentRole(), permission);
    }

    function isLiveAdmin() {
      return isLiveWhitelisted() && currentRole() == 'admin';
    }

    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
    }

    // 郵件附件允許圖片與常見文件格式
    function isAllowedAttachment() {
      return isImage()
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches(
             'application/(msword|vnd[.]openxmlformats-officedocument[.].*)');
    }

    function underSize(maxBytes) {
      return request.resource.size > 0 && request.resource.size < maxBytes;
    }

    // 品牌素材（信件與介面的 logo）：只有管理員能改。
    // 刻意把三種操作分開 —— delete 時沒有 request.resource，
    // 若在 delete 條件裡檢查 size 會因為存取 null 而永遠失敗。
    match /branding/{fileName} {
      allow read: if isLiveWhitelisted();
      allow create, update: if isLiveAdmin()
        && isImage()
        && underSize(2 * 1024 * 1024);
      allow delete: if isLiveAdmin();
    }

    // 新聞稿內文圖片：讀取只要是白名單使用者，寫入（含刪除既有檔案）
    // 需要 editPress 權限（見上方 hasPerm() 的 claims 版說明）。
    match /press/{pressId}/hero/{fileName} {
      allow read: if isLiveWhitelisted();
      allow create, update: if hasPerm('editPress')
        && isImage()
        && underSize(10 * 1024 * 1024);
      allow delete: if hasPerm('editPress');
    }

    // 郵件附件。sendCampaign 只會讀這個路徑底下的檔案。
    match /press/{pressId}/attachments/{fileName} {
      allow read: if isLiveWhitelisted();
      allow create, update: if hasPerm('editPress')
        && isAllowedAttachment()
        && underSize(10 * 1024 * 1024);
      allow delete: if hasPerm('editPress');
    }

    // 其他路徑一律拒絕，避免將來新增目錄時默默沿用寬鬆規則
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
